# порт и адрес API (для локального запуска без Docker)
PORT=3000
# HOST=127.0.0.1
# слушать не только localhost можно только с авторизацией
# AUTH_USER=admin
# AUTH_PASSWORD=change-me
# true — браузер бота без окна; на hh так капча не приходит
HEADLESS=false
# только для npm run session
HH_LOGIN=
HH_PASSWORD=
