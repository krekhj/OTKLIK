# Скопируй в .env рядом с docker-compose.yml и заполни.

# домен, направленный A-записью на VPS — Caddy получит для него HTTPS
DOMAIN=otklik.example.com

# вход на сайт (HTTP Basic). Обязательно: API принимает пароль от hh.ru
AUTH_USER=admin
AUTH_PASSWORD=change-me-to-a-long-random-string

# true — браузер без окна; на hh так капча не приходит, оставь false
HEADLESS=false
