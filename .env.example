# Скопируй в .env рядом с docker-compose.yml и заполни.

# вход на сайт (HTTP Basic). Обязательно: API принимает пароль от hh.ru
AUTH_USER=admin
AUTH_PASSWORD=change-me-to-a-long-random-string

# порт на хосте (только 127.0.0.1) — сюда проксирует nginx на VPS
APP_PORT=3100

# сколько прогонов может идти одновременно (у каждого свой Chromium, ~300–500 МБ)
MAX_RUNS=2

# true — браузер без окна; на hh так капча не приходит, оставь false
HEADLESS=false

# только для встроенного Caddy (docker compose --profile caddy up -d),
# если на VPS свободны 80/443
# DOMAIN=otklik.example.com
